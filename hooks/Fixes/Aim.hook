    mov ecx, esi
    push eax                              # target_pos
    lea eax, [esp + 4 + target_velocity]
    push eax
    lea eax, [esp + 8 + shooter_pos]
    push eax
    lea eax, [esp + 12 + aim_pos]
    push eax
    call @AimAddVelocity
    sub esp, 4                            # dead
    fst dword ptr [esp + dist]
    jmp 0x00631AD9
